# Variables du front-end (préfixe VITE_). ATTENTION : elles sont intégrées au bundle et donc
# PUBLIQUES. Ne jamais y placer de secret, clé privée ou jeton.

# « mock » : données fictives locales, aucun appel réseau (bandeau « Mode démonstration » affiché).
# « http » : API réelle. Valeur par défaut si absente : http.
VITE_API_MODE=http

# URL de base de l'API. Garder une URL relative (même origine) : la CSP Nginx actuelle
# (connect-src 'self') bloque les appels vers une autre origine.
VITE_API_BASE_URL=/api

# Délai maximal d'une requête en millisecondes.
VITE_API_TIMEOUT_MS=10000
